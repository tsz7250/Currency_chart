# 將此範例複製為 .env；已有 .env 時請手動合併，勿覆寫既有設定。
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=
# 使用 Gmail 應用程式密碼，不是一般登入密碼；輸入時移除顯示用空格。
SMTP_PASSWORD=
# 留空時使用 SMTP_USERNAME；Gmail 建議使用相同信箱。
ALERT_SENDER_EMAIL=
# 區域網路訪客使用時，改為主機的固定區域網路網址。
ALERT_BASE_URL=http://127.0.0.1:5000
# 允許區域網路連線時改為 0.0.0.0。
HOST=127.0.0.1
FORECAST_RELEASE_REPO=tsz7250/Currency_chart
# 一般部署使用 client；僅集中發布端設定 publisher。
FORECAST_ROLE=client
